# Copie para deploy/.env na VPS (nunca commite o .env) para enviar métricas, traces e logs ao Elastic Observability.
# Endpoint: Elastic > Add data > "Conecte-se diretamente ao endpoint" > aba OpenTelemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=https://<projeto>.ingest.<regiao>.gcp.elastic.cloud:443
# Chave de API criada na mesma tela ("Criar chave"). O espaço depois de ApiKey vai como %20.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey%20<chave>
