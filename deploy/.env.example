# Copie para deploy/.env na VPS (nunca commite o .env) para enviar métricas, traces e logs ao Elastic Observability.
# Endpoint: Elastic > Add data > "Conecte-se diretamente ao endpoint" > aba OpenTelemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=https://<projeto>.ingest.<regiao>.gcp.elastic.cloud:443
# Chave de API criada na mesma tela ("Criar chave"). O espaço depois de ApiKey vai como %20.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey%20<chave>

# Autenticacao da API. Use senhas fortes.
AUTH_ADMIN1_USERNAME=gft-admin
AUTH_ADMIN1_PASSWORD=<senha-forte-do-admin-1>
AUTH_ADMIN2_USERNAME=bradesco-admin
AUTH_ADMIN2_PASSWORD=<senha-forte-do-admin-2>
# Chave RSA privada que assina os JWTs (PKCS#8 em Base64, uma linha): make jwt-key
JWT_PRIVATE_KEY=<base64-pkcs8>
# Na rotação: a chave antiga vira JWT_PREVIOUS_PUBLIC_KEY (X.509 em Base64) até os tokens antigos vencerem.
# JWT_PREVIOUS_PUBLIC_KEY=
JWT_ISSUER=vinculos-api
JWT_TTL=PT15M
JWT_REFRESH_TTL=PT12H

# Chave do HMAC que pseudonimiza o documento na auditoria (pelo menos 32 caracteres aleatórios): openssl rand -hex 32
AUDIT_HASH_SECRET=<segredo-aleatorio>
AUDIT_RETENTION=P90D

# Opcional: webhook (Slack, Discord, ntfy...) para os alertas do deploy/monitor.sh.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...